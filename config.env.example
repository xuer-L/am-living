# === GitHub 部署 ===
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO=yourname/your-status-repo

# === 显示信息 ===
DISPLAY_NAME=YourName
DISPLAY_HANDLE=@yourhandle
FOOTER_TEXT=powered by am-living
COMMENT_AUTHOR=Agent

# === Agent 名称（显示在页面上的卡片）===
# Agent 配置（每行一个，格式：key|名称|头像文件名|心跳文件路径）
# 留空则不显示 Agent 区块
# 示例：AGENT_1=main|勘隙|kaltsit.png|/path/to/heartbeat.json
AGENT_1=
AGENT_2=

# === 数据目录 ===
STATUS_DIR=/path/to/status-page
SESSIONS_DIR=/path/to/.openclaw/agents/main/sessions

# === 可选数据源（留空则跳过）===
# Agent 配置（每行一个，格式：key|名称|头像文件名|心跳文件路径）
# 留空则不显示 Agent 区块
# 示例：AGENT_1=main|勘隙|kaltsit.png|/path/to/heartbeat.json
AGENT_1=
AGENT_2=
TODO_FILE=
COMMENT_FILE=

# === AI 摘要（二选一，优先 MiMo）===
MIMO_KEY=
MIMO_MODEL=mimo-v2.5-pro
DEEPSEEK_KEY=
DEEPSEEK_MODEL=deepseek-chat
